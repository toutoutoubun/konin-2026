{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:sandbox": "wrangler pages dev out --ip 0.0.0.0 --port 3000",
    "build": "next build",
    "preview": "wrangler pages dev out --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy out --project-name webapp",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000/english/",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "next": "14.2.29",
    "pdfjs-dist": "4.8.69",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.3",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3",
    "wrangler": "^3.78.0"
  }
}
